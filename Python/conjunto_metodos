linguagens = {"python", "js", "java"}

# ADD - adiciona um elemento ao conjunto
linguagens.add("csharp")
print(linguagens)


# COPY - copia os elementos de um conjunto para outro
linguagensCopia = linguagens.copy()
linguagensCopia.add("ts")
print(linguagensCopia)
print(id(linguagens), id(linguagensCopia))


# CLEAR - limpa o conjunto
linguagens.clear()
print(linguagens) # set()

print("---------------------------")

# DIFFERENCE - mostra os elementos que existem no primeiro conjunto, mas não existem no segundo
linguagens = {"python", "js", "java", "csharp"}
outrasLinguagens = {"python", "java", "ts"}
print(linguagens.difference(outrasLinguagens)) # {"js", "csharp"}

# INTERSECTION - mostra os elementos que existem nos dois conjuntos
print(linguagens.intersection(outrasLinguagens)) # {"python", "java"}


# UNION - junta os elementos dos dois conjuntos, eliminando os repetidos
print(linguagens.union(outrasLinguagens)) # {"python", "js", "java", "csharp", "ts"}


# ISSUBSET - verifica se todos os elementos de um conjunto estão presentes em outro conjunto
pequeno = {"python", "java"}
grande = {"python", "java", "js", "csharp"}
print(pequeno.issubset(grande)) # True

# ISSUPERSET - verifica se um conjunto possui todos os elementos de outro conjunto
print(grande.issuperset(pequeno)) # True

# ISDISJOINT - verifica se os conjuntos não possuem nenhum elemento em comum
a = {"python", "java"}
b = {"csharp", "javascript"}
print(a.isdisjoint(b)) # True


# POP - remove um elemento qualquer do conjunto
linguagens.pop()
print(linguagens)


# REMOVE - remove um elemento específico
linguagens.remove("js")
print(linguagens)


# DISCARD - remove um elemento específico,
# sem gerar erro caso ele não exista
linguagens.discard("python")
linguagens.discard("ruby")
print(linguagens)


# UPDATE - adiciona elementos de outro conjunto
linguagens.update({"ts", "golang"})
print(linguagens)


# LEN - mostra o tamanho do conjunto
print(len(linguagens))


print("---------------------------")